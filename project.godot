; Engine configuration file.
; GTA Vice Prototype — Godot 4.3 + GDScript + Compatibility (gl_compatibility) renderer.
; NOTE: scripts/* gameplay systems are owned by a parallel agent; this file only
; wires project-level settings (scenes, autoloads, input, layers, rendering).

config_version=5

[application]

config/name="GTA Vice Prototype"
config/description="Vice City-style open-world prototype (Godot 4.3 GDScript port)."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game_autoload.gd"
; SaveSystem autoload is implemented by scripts/core/save_bridge.gd
; (versioned user://savegame.json bridge over SaveService).
SaveSystem="*res://scripts/core/save_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 0 = Landscape (see ProjectSettings docs: 0 Landscape, 1 Portrait, ...).
window/handheld/orientation=0

[input_devices]

; Touch UI: emulate touch from mouse (desktop testing) and mouse from touch.
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true


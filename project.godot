[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="vehicle"
3d_physics/layer_3="trigger"

[physics]

; Jolt Physics is not bundled with Godot 4.3 (extension module only), so the
; built-in GodotPhysics3D is the default. To switch once the Jolt extension is
; installed: 3d/physics_engine="Jolt Physics 3D".
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]

; Compatibility (GLES3) renderer for mid-range 60fps on mobile + broad desktop.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/msaa_3d=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.05, 1)

[debug]

; Minimal GDScript warning noise: untyped declarations are allowed (rapid
; prototyping), unsafe accesses still warn.
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
